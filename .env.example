# Notion API Key - get from https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_api_key_here

# Target Notion page ID or URL where the hub will be created
NOTION_PAGE_ID=your_page_id_or_url_here

# GitHub Pages URL for the embedded widget (set after deploying)
GITHUB_PAGES_URL=https://yourusername.github.io/notion-work-hub/
